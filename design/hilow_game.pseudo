# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
INPUT lower_bound

OUTPUT "Enter the upper bound:"
INPUT upper_bound

WHILE lower_bound >= upper_bound
    OUTPUT "Invalid bounds. The lower bound must be less than the upper bound."
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound
    OUTPUT "Enter the upper bound:"
    INPUT upper_bound
END WHILE

    # Establish the number the player is trying to guess.
    target_number = RANDOM INTEGER BETWEEN lower_bound AND upper_bound

    # Play the game.
    OUTPUT "Guess a number between ", lower_bound, " and ", upper_bound
INPUT guess

WHILE guess < lower_bound OR guess > upper_bound
    OUTPUT "Invalid guess. Please enter a number within the range."
    INPUT guess
END WHILE
WHILE guess != target_number
    IF guess < target_number
        OUTPUT "Too low. Try again."
    ELSE
        OUTPUT "Too high. Try again."
    END IF

    OUTPUT "Enter another guess:"
    INPUT guess

    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Invalid guess. Please enter a number within the range."
        INPUT guess
    END WHILE
END WHILE

OUTPUT "Congratulations! You guessed the correct number."
END hilow_game

